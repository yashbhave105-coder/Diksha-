@model List<Disha.Web.Controllers.TechHubLocation>
@{
    ViewData["Title"] = "Free Local IT Hubs & Digital Labs - Disha";
    string? selectedCity = ViewBag.SelectedCity as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-mint text-white px-3 py-1 rounded-pill fw-bold"><i class="bi bi-geo-alt-fill me-1"></i> Physical Access Directory</span>
                <span class="badge bg-light text-dark border px-3 py-1 rounded-pill fw-bold">100% Free Public Wi-Fi & Desktops</span>
            </div>
            <h2 class="fw-bold text-navy mb-1" style="color: #0B1330;">Free Community Computer Labs & Libraries</h2>
            <p class="text-muted mb-0">Don't have a PC at home? Find free, safe public access centers and digital reading rooms near you.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="TechHubs" class="btn btn-sm @(string.IsNullOrEmpty(selectedCity) ? "btn-navy" : "btn-light border") fw-medium">All Cities</a>
            <a asp-action="TechHubs" asp-route-city="Mumbai" class="btn btn-sm @(selectedCity == "Mumbai" ? "btn-mint text-white" : "btn-light border") fw-medium">Mumbai</a>
            <a asp-action="TechHubs" asp-route-city="Delhi" class="btn btn-sm @(selectedCity == "Delhi" ? "btn-mint text-white" : "btn-light border") fw-medium">Delhi</a>
            <a asp-action="TechHubs" asp-route-city="Bangalore" class="btn btn-sm @(selectedCity == "Bangalore" ? "btn-mint text-white" : "btn-light border") fw-medium">Bangalore</a>
            <a asp-action="TechHubs" asp-route-city="Pune" class="btn btn-sm @(selectedCity == "Pune" ? "btn-mint text-white" : "btn-light border") fw-medium">Pune</a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        @foreach (var h in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column" style="border:1px solid #E2E8F0;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1 rounded">@h.Type</span>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded">@h.Cost</span>
                    </div>

                    <h5 class="fw-bold text-navy mb-2" style="color:#0B1330;">@h.Name</h5>
                    
                    <p class="text-muted small mb-2">
                        <i class="bi bi-geo-alt text-danger me-1"></i> @h.Address, <strong>@h.City</strong>
                    </p>

                    <div class="bg-light p-3 rounded-3 mb-3 small flex-grow-1">
                        <div class="mb-1"><strong>Facilities:</strong> @h.Facilities</div>
                        <div><strong>Hours:</strong> @h.Timings</div>
                    </div>

                    <a href="https://maps.google.com/?q=@(Uri.EscapeDataString(h.Name + " " + h.City))" target="_blank" class="btn btn-outline-primary btn-sm w-100 fw-bold rounded-pill">
                        Open in Google Maps <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Alert Advice Box -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-light border-start border-4 border-success">
        <h6 class="fw-bold text-navy mb-1"><i class="bi bi-info-circle-fill text-success me-1"></i> Student Tip for Public Labs:</h6>
        <p class="small text-muted mb-0">
            Carry a small 8GB/16GB USB drive to save your code assignments, and keep your government Aadhaar/college student ID card handy for library registration.
        </p>
    </div>
</div>
