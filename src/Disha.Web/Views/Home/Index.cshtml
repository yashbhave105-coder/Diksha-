@{
    ViewData["Title"] = "Welcome to Disha - IT Careers Portal";
}

<div class="container py-5">
    <div class="row align-items-center gy-5">
        <div class="col-lg-7">
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold mb-3 fs-6">
                <i class="bi bi-star-fill me-1"></i> Dedicated exclusively to IT Careers
            </span>
            <h1 class="display-4 fw-extrabold text-navy mb-3" style="color: #0B1330; font-weight: 800;">
                Your Debt-Free Gateway to High-Demand <span style="color: #1DB88E;">IT Careers</span>
            </h1>
            <p class="lead text-secondary mb-4 fs-5" style="max-width: 620px;">
                Disha guides underprivileged students in India toward lucrative tech careers with zero tuition debt. Get personalized IT career matches, laptop subsidies, and 24/7 assistance from your AI Mentor.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-mint btn-lg px-4 py-3 rounded-3 shadow-sm fw-bold">
                    Start Assessment Quiz <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-navy btn-lg px-4 py-3 rounded-3 shadow-sm fw-bold">
                    Log In to Your Portal
                </a>
            </div>

            <div class="row mt-5 pt-3 g-4 border-top">
                <div class="col-4">
                    <h3 class="fw-bold text-navy mb-0">12+</h3>
                    <small class="text-muted">IT Career Tracks</small>
                </div>
                <div class="col-4">
                    <h3 class="fw-bold text-success mb-0">100%</h3>
                    <small class="text-muted">Free & Debt-Free</small>
                </div>
                <div class="col-4">
                    <h3 class="fw-bold text-primary mb-0">24/7</h3>
                    <small class="text-muted">AI Mentor Assistance</small>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: #0B1330; color: #fff;">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fs-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-compass"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Disha Guidance Engine</h4>
                            <small class="text-secondary">Empowering First-Generation Learners</small>
                        </div>
                    </div>
                    <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span>No prior computer coding experience required</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span>Matched with laptops & connectivity grants</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span>Step-by-step roadmap to entry-level IT jobs</span>
                        </li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-mint w-100 py-3 fw-bold rounded-3">
                        Create Free Student Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
