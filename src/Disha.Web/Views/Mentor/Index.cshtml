@model List<Disha.Web.Models.Entities.MentorChatMessage>
@{
    ViewData["Title"] = "24/7 AI Mentor - Disha Guidance";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <!-- MENTOR HEADER -->
                <div class="card-header bg-navy text-white p-4 border-0" style="background: #0B1330;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fs-3" style="width:48px; height:48px;">
                                <i class="bi bi-robot"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-0">Disha AI Mentor Desk</h4>
                                <small class="text-secondary"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Powered by Groq (Llama 3) with Gemini Failover</small>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-3 py-2 rounded-pill">
                            100% Free & Encouraging IT Guide
                        </span>
                    </div>
                </div>

                <!-- CHAT MESSAGES BODY -->
                <div class="card-body p-4">
                    <div id="mentorChatBox" class="chat-box mb-4" style="height: 480px; max-height: 520px;">
                        <div class="chat-msg ai">
                            <div>Hello! I am your Disha AI Mentor. Ask me any question about IT career tracks, learning timelines, study tips, or financial aid options!</div>
                            <span class="provider-badge">AI MENTOR</span>
                        </div>
                        @foreach (var msg in Model)
                        {
                            <div class="chat-msg @msg.Sender">
                                <div>@msg.Message</div>
                                @if (msg.Sender == "ai")
                                {
                                    <span class="provider-badge">AI MENTOR</span>
                                }
                            </div>
                        }
                    </div>

                    <!-- VOICE & LANGUAGE BAR -->
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark border"><i class="bi bi-translate text-primary me-1"></i> Multilingual Mode</span>
                            <select id="mentorSpeechLang" class="form-select form-select-sm" style="width: auto;">
                                <option value="en-IN">Indian English</option>
                                <option value="hi-IN">Hindi / Hinglish</option>
                                <option value="mr-IN">Marathi</option>
                                <option value="ta-IN">Tamil</option>
                                <option value="te-IN">Telugu</option>
                            </select>
                        </div>
                        <div class="form-check form-switch small">
                            <input class="form-check-input" type="checkbox" id="autoReadAloudToggle">
                            <label class="form-check-label fw-bold text-secondary" for="autoReadAloudToggle">
                                <i class="bi bi-volume-up-fill text-mint me-1"></i> Speak Replies Out Loud
                            </label>
                        </div>
                    </div>

                    <!-- CHAT INPUT FORM -->
                    <form id="mentorChatForm" class="d-flex gap-2">
                        <button type="button" id="mentorMicBtn" class="btn btn-outline-danger px-3 py-3 rounded-3" title="Click to speak">
                            <i class="bi bi-mic-fill fs-5"></i>
                        </button>
                        <input type="text" id="mentorMessageInput" class="form-control form-control-lg" placeholder="Type or speak (e.g. bina laptop ke coding kaise seekhe?)" required />
                        <button type="submit" class="btn btn-mint px-4 py-3 fw-bold fs-5 text-white shadow-sm">
                            Send <i class="bi bi-send-fill ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
